# Copy this file to terraform.tfvars and replace the placeholder values.
# Do not commit terraform.tfvars to version control.

project_name = "capstone-phoenix"
ami_id = "ami-xxxxxxxxxxxxxxxxx"
my_ip = "<your-public-ip>/32"
region = "us-east-1"
ssh_public_key_path = "~/.ssh/capstone-phoenix.pub"

instance_type = "t3.small"